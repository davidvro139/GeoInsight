# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=geoinsight
MYSQL_USER=geoinsight
MYSQL_PASSWORD=changeme

# --- API / JWT ---
# Generate a long random value for local dev, e.g.:
#   openssl rand -base64 48
JWT_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ISSUER=GeoInsight.Api
JWT_AUDIENCE=GeoInsight.Client

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
